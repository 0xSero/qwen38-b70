+static void cont_sigmoid_mul_q8_1_soa_kernel(
+        const float * view, const float * pre, float * dst, char * q8,
+        const uint64_t k, const int64_t vne0, const int64_t vne1, const int64_t vne2,
+        const int64_t vs0, const int64_t vs1, const int64_t vs2, const int64_t vs3,
+        const sycl::nd_item<1> & item) {
+    static_assert(QK8_1 % WARP_SIZE == 0);
+    constexpr int elements_per_wi = QK8_1 / WARP_SIZE;
+    constexpr int subgroups_per_wg = SYCL_GLU_BLOCK_SIZE / WARP_SIZE;
+    const auto sg = item.get_sub_group();
+    const int sg_id = (int) sg.get_group_linear_id();
+    const int lane = (int) sg.get_local_linear_id();
+    const uint64_t block = item.get_group(0) * subgroups_per_wg + sg_id;
+    if (block >= k / QK8_1) {
+        return;
+    }
+
+    const uint64_t offset = block * QK8_1 + lane * elements_per_wi;
+    sycl::vec<float, elements_per_wi> values;
+    sycl::vec<int8_t, elements_per_wi> quantized;
+    float sum = 0.0f;
+    float amax = 0.0f;
+#pragma unroll(elements_per_wi)
+    for (int j = 0; j < elements_per_wi; ++j) {
+        const int64_t i = (int64_t) offset + j;
+        const int64_t i0 = i % vne0;
+        int64_t r = i / vne0;
+        const int64_t i1 = r % vne1;
+        r /= vne1;
+        const int64_t i2 = r % vne2;
+        const int64_t i3 = r / vne2;
+        const float x = view[i0 * vs0 + i1 * vs1 + i2 * vs2 + i3 * vs3];
+        values[j] = pre[i] * op_sigmoid(x);
+        dst[i] = values[j];
+        sum += values[j];
+        amax = sycl::fmax(amax, sycl::fabs(values[j]));
+        quantized[j] = 0;
+    }
+    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+    amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+    const float d = amax == 0.0f ? 1.0f : amax / 127;
+#pragma unroll(elements_per_wi)
+    for (int j = 0; j < elements_per_wi; ++j) {
+        quantized[j] = sycl::round(values[j] / d);
+    }
+    *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(q8 + offset) = quantized;
+    if (lane == 0) {
+        auto * ds = reinterpret_cast<sycl::half2 *>(q8 + k);
+        ds[block] = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+    }
+}
