+bool ggml_sycl_mul_mat_vec_q8_0_reorder_quad_gdn_processed(
+        const void * vx0, const void * vx1, const void * vx2, const void * vx3, const void * vy,
+        const float * alpha_bias, const float * alpha_scale,
+        float * dst0, float * dst1, float * dst2, float * dst3,
+        int ncols, int nrows0, int nrows1, int nrows2, int nrows3,
+        dpct::queue_ptr stream) {
+    if (ncols % QK8_0 != 0 || nrows0 <= 0 || nrows1 <= 0 || nrows2 <= 0 || nrows3 <= 0 ||
+            alpha_bias == nullptr || alpha_scale == nullptr ||
+            ggml_sycl_mmvq_q8_narrow() || ggml_sycl_mmvq_q8_mutant() ||
+            ggml_sycl_mmvq_use_sg32() || ggml_sycl_mmvq_use_phase()) {
+        return false;
+    }
+    ggml_sycl_assert_q8_wide_align(vx0, vy, 16);
+    ggml_sycl_assert_q8_wide_align(vx1, vy, 16);
+    ggml_sycl_assert_q8_wide_align(vx2, vy, 16);
+    ggml_sycl_assert_q8_wide_align(vx3, vy, 16);
+
+    const size_t num_subgroups = (size_t) ggml_sycl_mmvq_subgroups();
+    const int nrows = nrows0 + nrows1 + nrows2 + nrows3;
+    const int block_num_y = ceil_div(nrows, GGML_SYCL_MMV_Y * (int) num_subgroups);
+    const sycl::range<3> block_nums(1, 1, block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, num_subgroups * WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> nd_item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q8_0_reorder_quad_gdn_processed(
+                    vx0, vx1, vx2, vx3, vy, alpha_bias, alpha_scale,
+                    dst0, dst1, dst2, dst3,
+                    ncols, nrows0, nrows1, nrows2, nrows3, nd_item);
+            });
+    });
+    return true;
+}
