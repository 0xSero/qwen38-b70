+    const uint64_t n_workgroups = ceil_div(n_qblocks, (uint64_t) subgroups_per_wg);
+    float * out = static_cast<float *>(dst->data);
+    char * q8_out = static_cast<char *>(q8);
+    queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    stream->parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(n_workgroups * SYCL_GLU_BLOCK_SIZE),
+                              sycl::range<1>(SYCL_GLU_BLOCK_SIZE)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                swiglu_q8_1_soa_kernel(x, g, out, q8_out, k, item);
