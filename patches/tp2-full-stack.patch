+static bool ggml_sycl_find_gdn_mmvq_quad(
+        const ggml_cgraph * cgraph, int i,
+        int * z_index, int * alpha_index, int * beta_index,
+        int * alpha_add_index, int * alpha_softplus_index, int * gate_index) {
+    if (!g_ggml_sycl_fused_mmvq_quad_gdn || i < 0 || i >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * qkv = cgraph->nodes[i];
+    if (qkv == nullptr || qkv->op != GGML_OP_MUL_MAT || qkv->src[0] == nullptr ||
+            std::strstr(qkv->src[0]->name, ".attn_qkv.weight") == nullptr) {
+        return false;
+    }
+
+    *z_index = *alpha_index = *beta_index = -1;
+    *alpha_add_index = *alpha_softplus_index = *gate_index = -1;
+    const int end = std::min(cgraph->n_nodes, i + 65);
+    for (int j = i + 1; j < end; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node == nullptr || node->op != GGML_OP_MUL_MAT ||
+                node->src[0] == nullptr || node->src[1] != qkv->src[1]) {
+            continue;
+        }
+        const char * name = node->src[0]->name;
+        if (*z_index < 0 && std::strstr(name, ".attn_gate.weight") != nullptr) {
+            *z_index = j;
+        } else if (*alpha_index < 0 && std::strstr(name, ".ssm_alpha.weight") != nullptr) {
+            *alpha_index = j;
+        } else if (*beta_index < 0 && std::strstr(name, ".ssm_beta.weight") != nullptr) {
+            *beta_index = j;
+        }
+    }
+    if (*z_index < 0 || *alpha_index < 0 || *beta_index < 0) {
+        return false;
+    }
+
+    ggml_tensor * alpha = cgraph->nodes[*alpha_index];
+    for (int j = i + 1; j < end; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node == nullptr) {
+            continue;
+        }
+        if (*alpha_add_index < 0 && node->op == GGML_OP_ADD &&
+                (ggml_sycl_unwrap_shape_view(node->src[0]) == alpha ||
+                 ggml_sycl_unwrap_shape_view(node->src[1]) == alpha)) {
+            *alpha_add_index = j;
+            continue;
+        }
+        if (*alpha_add_index >= 0 && *alpha_softplus_index < 0 &&
+                node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_SOFTPLUS &&
+                node->src[0] == cgraph->nodes[*alpha_add_index]) {
+            *alpha_softplus_index = j;
+            continue;
+        }
+        if (*alpha_softplus_index >= 0 && *gate_index < 0 && node->op == GGML_OP_MUL &&
+                (node->src[0] == cgraph->nodes[*alpha_softplus_index] ||
+                 node->src[1] == cgraph->nodes[*alpha_softplus_index])) {
+            *gate_index = j;
+        }
+    }
+    if (*alpha_add_index < 0 || *alpha_softplus_index < 0 || *gate_index < 0) {
+        return false;
+    }
+
+    const int output_indices[3] = { *z_index, *beta_index, *gate_index };
+    for (int index : output_indices) {
+        ggml_tensor * early = cgraph->nodes[index];
+        for (int j = i + 1; j < index; ++j) {
+            ggml_tensor * intervening = cgraph->nodes[j];
+            const ggml_tensor * base = ggml_sycl_unwrap_shape_view(intervening);
+            const bool elided_alpha_chain =
+                intervening == cgraph->nodes[*alpha_index] ||
+                intervening == cgraph->nodes[*alpha_add_index] ||
+                intervening == cgraph->nodes[*alpha_softplus_index] ||
+                intervening == cgraph->nodes[*gate_index] ||
+                base == cgraph->nodes[*alpha_index] ||
+                base == cgraph->nodes[*alpha_add_index] ||
+                base == cgraph->nodes[*alpha_softplus_index];
+            if (!elided_alpha_chain && ggml_sycl_pair_ranges_overlap(early, intervening)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
