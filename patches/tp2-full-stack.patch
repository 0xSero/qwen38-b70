+                add_outputs[i]->type != GGML_TYPE_F32 || rms_nodes[i]->type != GGML_TYPE_F32 ||
+                mul_nodes[i]->type != GGML_TYPE_F32 ||
+                ggml_nelements(partials[i]) != nelem || ggml_nelements(residuals[i]) != nelem ||
+                ggml_nelements(add_outputs[i]) != nelem || ggml_nelements(rms_nodes[i]) != nelem ||
+                ggml_nelements(mul_nodes[i]) != nelem || ggml_nrows(partials[i]) != 1 ||
