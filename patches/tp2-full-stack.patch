+        float * mul0, float * mul1, char * q8_out0, char * q8_out1) {
+    q0->submit([=](sycl::handler & h) {
+        h.depends_on(reduce_add);
+        sycl::local_accessor<float, 1> sums(sycl::range<1>(work_group_size0 / WARP_SIZE), h);
+        const sycl::range<3> block(1, 1, work_group_size0);
+        h.parallel_for(sycl::nd_range<3>(block, block), [=](sycl::nd_item<3> item)
+                [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int tid = item.get_local_id(2);
+            const int nwarps = work_group_size0 / WARP_SIZE;
+            float tmp = 0.0f;
+            for (int64_t col = tid; col < nelem; col += work_group_size0) {
+                const float value = add0[col];
+                tmp += value * value;
+            }
+            tmp = warp_reduce_sum(tmp, item);
+            if (work_group_size0 > WARP_SIZE) {
+                const auto sub_group = item.get_sub_group();
+                const auto sg_id = sub_group.get_group_linear_id();
+                const auto wi_in_sg = sub_group.get_local_linear_id();
