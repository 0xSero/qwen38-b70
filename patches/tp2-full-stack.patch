+                const int64_t offset = qblock * QK8_1 + lane * elements_per_wi;
+                float values[elements_per_wi];
+                sycl::vec<int8_t, elements_per_wi> quantized;
+                float sum = 0.0f;
+                float amax = 0.0f;
+#pragma unroll(elements_per_wi)
+                for (int j = 0; j < elements_per_wi; ++j) {
+                    const int64_t col = offset + j;
+                    const float value = scale * add1[col] * w1[col];
+                    mul1[col] = value;
+                    values[j] = value;
+                    sum += value;
+                    amax = sycl::fmax(amax, sycl::fabs(value));
+                    quantized[j] = 0;
+                }
