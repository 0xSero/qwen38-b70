+bool ggml_sycl_op_cont_sigmoid_mul_q8(
+        ggml_backend_sycl_context & ctx, ggml_tensor * cont, ggml_tensor * unary,
+        ggml_tensor * mul_t, void * q8) {
+    const ggml_tensor * view = cont->src[0];
+    const ggml_tensor * pre_t = (mul_t->src[0] == unary) ? mul_t->src[1] : mul_t->src[0];
+    if (q8 == nullptr || view == nullptr || pre_t == nullptr ||
+            view->type != GGML_TYPE_F32 || pre_t->type != GGML_TYPE_F32 ||
+            mul_t->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul_t) ||
+            ggml_nrows(mul_t) != 1 || ggml_nelements(mul_t) % QK8_1 != 0) {
+        return false;
+    }
+
+    const uint64_t k = ggml_nelements(mul_t);
+    constexpr int subgroups_per_wg = SYCL_GLU_BLOCK_SIZE / WARP_SIZE;
+    const uint64_t n_qblocks = k / QK8_1;
+    const uint64_t n_workgroups = ceil_div(n_qblocks, (uint64_t) subgroups_per_wg);
+    const float * v = static_cast<const float *>(view->data);
+    const float * pre = static_cast<const float *>(pre_t->data);
+    float * dst = static_cast<float *>(mul_t->data);
+    char * q8_out = static_cast<char *>(q8);
+    const int64_t vne0 = view->ne[0], vne1 = view->ne[1], vne2 = view->ne[2];
+    const int64_t vs0 = view->nb[0] / sizeof(float);
+    const int64_t vs1 = view->nb[1] / sizeof(float);
+    const int64_t vs2 = view->nb[2] / sizeof(float);
+    const int64_t vs3 = view->nb[3] / sizeof(float);
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    stream->parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(n_workgroups * SYCL_GLU_BLOCK_SIZE),
+                              sycl::range<1>(SYCL_GLU_BLOCK_SIZE)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                cont_sigmoid_mul_q8_1_soa_kernel(
+                        v, pre, dst, q8_out, k, vne0, vne1, vne2,
+                        vs0, vs1, vs2, vs3, item);
+            });
+    return true;
+}
