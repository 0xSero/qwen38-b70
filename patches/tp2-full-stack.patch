+        const ggml_tensor * w1, const char * suffix1,
+        const ggml_tensor * w2, const char * suffix2) {
+    const char * p0 = std::strstr(w0->name, suffix0);
+    const char * p1 = std::strstr(w1->name, suffix1);
+    const char * p2 = std::strstr(w2->name, suffix2);
+    if (p0 == nullptr || p1 == nullptr || p2 == nullptr ||
+            std::strncmp(w0->name, "blk.", 4) != 0 ||
+            std::strncmp(w1->name, "blk.", 4) != 0 ||
+            std::strncmp(w2->name, "blk.", 4) != 0) {
+        return false;
+    }
+    const ptrdiff_t prefix = p0 - w0->name;
+    return p1 - w1->name == prefix && p2 - w2->name == prefix &&
+           std::strncmp(w0->name, w1->name, prefix) == 0 &&
+           std::strncmp(w0->name, w2->name, prefix) == 0;
+}
+
+static bool ggml_sycl_same_layer_weight_roles4(
+        const ggml_tensor * w0, const char * suffix0,
+        const ggml_tensor * w1, const char * suffix1,
+        const ggml_tensor * w2, const char * suffix2,
+        const ggml_tensor * w3, const char * suffix3) {
+    const char * p0 = std::strstr(w0->name, suffix0);
+    const char * p1 = std::strstr(w1->name, suffix1);
+    const char * p2 = std::strstr(w2->name, suffix2);
+    const char * p3 = std::strstr(w3->name, suffix3);
+    if (p0 == nullptr || p1 == nullptr || p2 == nullptr || p3 == nullptr ||
+            std::strncmp(w0->name, "blk.", 4) != 0 ||
+            std::strncmp(w1->name, "blk.", 4) != 0 ||
+            std::strncmp(w2->name, "blk.", 4) != 0 ||
+            std::strncmp(w3->name, "blk.", 4) != 0) {
+        return false;
+    }
+    const ptrdiff_t prefix = p0 - w0->name;
+    return p1 - w1->name == prefix && p2 - w2->name == prefix && p3 - w3->name == prefix &&
+           std::strncmp(w0->name, w1->name, prefix) == 0 &&
+           std::strncmp(w0->name, w2->name, prefix) == 0 &&
+           std::strncmp(w0->name, w3->name, prefix) == 0;
+}
