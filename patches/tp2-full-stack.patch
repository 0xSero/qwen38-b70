+static bool ggml_sycl_fuse_gdn_mmvq_triple(
+        ggml_backend_sycl_context & ctx,
+        ggml_tensor * qkv, ggml_tensor * z, ggml_tensor * alpha) {
+    if (!g_ggml_sycl_fused_mmvq_triple_gdn || g_ggml_sycl_q8_quant_dedup != 1 ||
+            qkv == nullptr || z == nullptr || alpha == nullptr ||
+            qkv->op != GGML_OP_MUL_MAT || z->op != GGML_OP_MUL_MAT || alpha->op != GGML_OP_MUL_MAT ||
+            qkv->src[0] == nullptr || qkv->src[1] == nullptr ||
+            z->src[0] == nullptr || z->src[1] != qkv->src[1] ||
+            alpha->src[0] == nullptr || alpha->src[1] != qkv->src[1]) {
+        return false;
+    }
+
+    ggml_tensor * wqkv = qkv->src[0];
+    ggml_tensor * wz   = z->src[0];
+    ggml_tensor * wa   = alpha->src[0];
+    ggml_tensor * act  = qkv->src[1];
+    if (!ggml_sycl_same_layer_weight_roles(
+            wqkv, ".attn_qkv.weight", wz, ".attn_gate.weight", wa, ".ssm_alpha.weight") ||
+            wqkv->type != GGML_TYPE_Q8_0 || wz->type != GGML_TYPE_Q8_0 || wa->type != GGML_TYPE_Q8_0 ||
+            act->type != GGML_TYPE_F32 || qkv->type != GGML_TYPE_F32 ||
+            z->type != GGML_TYPE_F32 || alpha->type != GGML_TYPE_F32 ||
+            ggml_backend_buffer_is_sycl_split(wqkv->buffer) ||
+            ggml_backend_buffer_is_sycl_split(wz->buffer) ||
+            ggml_backend_buffer_is_sycl_split(wa->buffer) ||
+            !ggml_is_contiguous(wqkv) || !ggml_is_contiguous(wz) || !ggml_is_contiguous(wa) ||
+            !ggml_is_contiguous(act) || !ggml_is_contiguous(qkv) ||
+            !ggml_is_contiguous(z) || !ggml_is_contiguous(alpha) ||
+            ggml_nrows(act) != 1 || qkv->ne[1] != 1 || z->ne[1] != 1 || alpha->ne[1] != 1 ||
+            act->ne[2] != 1 || act->ne[3] != 1 ||
+            wqkv->ne[0] != act->ne[0] || wz->ne[0] != act->ne[0] || wa->ne[0] != act->ne[0] ||
+            qkv->ne[0] != wqkv->ne[1] || z->ne[0] != wz->ne[1] || alpha->ne[0] != wa->ne[1] ||
+            act->ne[0] % QK8_1 != 0 ||
+            ggml_sycl_pair_ranges_overlap(qkv, z) ||
+            ggml_sycl_pair_ranges_overlap(qkv, alpha) ||
+            ggml_sycl_pair_ranges_overlap(z, alpha) ||
+            ggml_sycl_pair_ranges_overlap(qkv, act) ||
+            ggml_sycl_pair_ranges_overlap(z, act) ||
+            ggml_sycl_pair_ranges_overlap(alpha, act)) {
+        return false;
+    }
+
+    opt_for_reorder(&ctx, wqkv, act, qkv,   mul_mat_algo::MMVQ);
+    opt_for_reorder(&ctx, wz,   act, z,     mul_mat_algo::MMVQ);
+    opt_for_reorder(&ctx, wa,   act, alpha, mul_mat_algo::MMVQ);
+    const auto * eqkv = static_cast<const ggml_tensor_extra_gpu *>(wqkv->extra);
+    const auto * ez   = static_cast<const ggml_tensor_extra_gpu *>(wz->extra);
+    const auto * ea   = static_cast<const ggml_tensor_extra_gpu *>(wa->extra);
+    if (eqkv == nullptr || ez == nullptr || ea == nullptr ||
+            !eqkv->optimized_feature.reorder || !ez->optimized_feature.reorder ||
+            !ea->optimized_feature.reorder) {
+        return false;
+    }
+
+    const int64_t padded = GGML_PAD(act->ne[0], MATRIX_ROW_PADDING);
+    const size_t q8_size = (size_t) padded * sizeof(block_q8_1) / QK8_1;
+    bool hit = false;
+    char * q8 = ggml_sycl_q8_dedup_lookup(
+        ctx, act, /* reordered SOA = */ 1, act->ne[0], 1, padded, q8_size, hit);
+    if (q8 == nullptr) {
+        return false;
+    }
+    if (!hit) {
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            static_cast<const float *>(act->data), q8, act->ne[0], 1, padded, ctx.stream());
+        g_q8_quant_launches.fetch_add(1, std::memory_order_relaxed);
+        if (ggml_sycl_q8_dedup_poison_on()) {
+            ctx.stream()->memset(q8 + 4, 0x40, 2);
+        }
+    }
+
+    if (!ggml_sycl_mul_mat_vec_q8_0_reorder_triple(
+            wqkv->data, wz->data, wa->data, q8,
+            static_cast<float *>(qkv->data), static_cast<float *>(z->data),
+            static_cast<float *>(alpha->data),
+            (int) act->ne[0], (int) wqkv->ne[1], (int) wz->ne[1],
+            (int) wa->ne[1], ctx.stream())) {
+        return false;
+    }
+
+    g_q8_dedup_hits.fetch_add(hit ? 3 : 2, std::memory_order_relaxed);
+    g_q8_fused_mmvq_gdn_triples.fetch_add(1, std::memory_order_relaxed);
+    const char * poison = std::getenv("GGML_SYCL_FUSED_MMVQ_TRIPLE_GDN_POISON");
+    if (poison && std::atoi(poison) != 0) {
+        ctx.stream()->memset(alpha->data, 0x7f, sizeof(float));
+    }
+    return true;
+}
