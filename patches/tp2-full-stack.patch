+static void gdn_silu_mul_q8_1_soa_kernel(
+        const float * gate, const float * norm, float * silu_out,
+        float * final_out, char * q8, const sycl::nd_item<1> & item) {
+    static_assert(QK8_1 % WARP_SIZE == 0);
+    constexpr int ncols = 128;
+    constexpr int elements_per_wi = QK8_1 / WARP_SIZE;
+    constexpr int blocks_per_row = ncols / QK8_1;
+    constexpr int threads_per_row = blocks_per_row * WARP_SIZE;
+    const int64_t row = item.get_group(0);
+    const int tid = item.get_local_id(0);
+    const int64_t row_off = row * ncols;
+
+    // Preserve the two stock FP32 boundaries exactly: SILU writes its rounded
+    // output, then MUL re-reads it. The barriers are workgroup-global because
+    // one workgroup owns the complete 128-element GDN head.
+    for (int col = tid; col < ncols; col += threads_per_row) {
+        silu_out[row_off + col] = op_silu(gate[row_off + col]);
+    }
+    item.barrier(sycl::access::fence_space::global_and_local);
+    for (int col = tid; col < ncols; col += threads_per_row) {
+        final_out[row_off + col] = norm[row_off + col] * silu_out[row_off + col];
+    }
+    item.barrier(sycl::access::fence_space::global_and_local);
+
+    const auto sg = item.get_sub_group();
+    const int sg_id = (int) sg.get_group_linear_id();
+    const int lane = (int) sg.get_local_linear_id();
+    int8_t * qs = reinterpret_cast<int8_t *>(q8);
+    sycl::half2 * ds = reinterpret_cast<sycl::half2 *>(q8 + 24 * ncols);
+    // Four subgroups own the four Q8 blocks in a head concurrently.  The
+    // previous single-subgroup prototype serialized this loop four times.
+    const int64_t block = row * blocks_per_row + sg_id;
+    const int64_t off = block * QK8_1 + lane * elements_per_wi;
+    const auto values = *reinterpret_cast<const sycl::vec<float, elements_per_wi> *>(final_out + off);
+    sycl::vec<int8_t, elements_per_wi> quantized;
+    float sum = 0.0f;
+    float amax = 0.0f;
+#pragma unroll(elements_per_wi)
+    for (int j = 0; j < elements_per_wi; ++j) {
+        sum += values[j];
+        amax = sycl::fmax(amax, sycl::fabs(values[j]));
+        quantized[j] = 0;
+    }
+    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+    amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+    const float d = amax == 0.0f ? 1.0f : amax / 127;
+#pragma unroll(elements_per_wi)
+    for (int j = 0; j < elements_per_wi; ++j) {
+        quantized[j] = sycl::round(values[j] / d);
+    }
+    *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(qs + off) = quantized;
+    if (lane == 0) {
+        ds[block] = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+    }
+}
