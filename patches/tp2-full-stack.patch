+    const int64_t nc = src1 != nullptr ? src0->ne[0] : src0->ne[0] / 2;
+    if (dst->ne[0] != nc || ggml_nelements(dst) != nc ||
+            (src1 != nullptr && src1->ne[0] != nc)) {
