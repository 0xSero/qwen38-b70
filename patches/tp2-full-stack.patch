+        if (q_l2 == nullptr || k_l2 == nullptr || q_l2_index <= conv_index || k_l2_index <= q_l2_index ||
+                q_l2->type != GGML_TYPE_F32 || k_l2->type != GGML_TYPE_F32 ||
+                q_l2->ne[0] != 128 || q_l2->ne[1] != 8 || q_l2->ne[2] != 1 || q_l2->ne[3] != 1 ||
+                k_l2->ne[0] != 128 || k_l2->ne[1] != 8 || k_l2->ne[2] != 1 || k_l2->ne[3] != 1 ||
+                !ggml_is_contiguous(q_l2) || !ggml_is_contiguous(k_l2)) {
+            return false;
+        }
+        float q_eps;
+        float k_eps;
+        memcpy(&q_eps, q_l2->op_params, sizeof(float));
+        memcpy(&k_eps, k_l2->op_params, sizeof(float));
+        if (q_eps < 0.0f || q_eps != k_eps) {
+            return false;
+        }
+    }
+
+    // GET_ROWS may feed shape-only aliases en route to this CONCAT, but no
+    // other compute consumer is safe to bypass.
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = node->src[s];
+            if (src == nullptr || ggml_sycl_unwrap_shape_view(src) != get) {
+                continue;
+            }
+            const bool shape_only = node->op == GGML_OP_RESHAPE || node->op == GGML_OP_VIEW ||
+                node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE;
+            if (!shape_only && !(node == concat && s == 0)) {
+                return false;
+            }
+        }
+    }
+
+    match->concat = concat;
+    match->cpy = cpy;
+    match->conv = conv;
+    match->silu = silu;
+    match->q_l2 = q_l2;
+    match->k_l2 = k_l2;
+    match->state = state;
+    match->current = current;
+    return true;
+}
+
+struct ggml_sycl_gdn_state_io_match {
+    ggml_tensor * gdn;
+    ggml_tensor * cpy;
+    ggml_tensor * state;
+};
+
+// Qwen3.6 recurrent decode normally copies the persistent GDN state into a
+// temporary, lets GATED_DELTA_NET write a second temporary, then copies that
+// result back.  With one sequence and one retained state slot, the selected
+// input row and CPY destination are the same contiguous buffer.  Each GDN
+// workgroup owns one state column and loads it completely before writing, so
+// the kernel can update that buffer in place and both transfer kernels vanish.
+// Keep this matcher intentionally strict; any wider batch/snapshot/layout uses
+// the stock GET_ROWS -> GDN -> CPY path.
+static bool ggml_sycl_find_gdn_state_io(
+        const ggml_cgraph * cgraph, int i, ggml_sycl_gdn_state_io_match * match) {
+    if (!g_ggml_sycl_fused_gdn_state_io || !g_ggml_sycl_fused_gdn_beta_sigmoid ||
+            i < 0 || i >= cgraph->n_nodes || match == nullptr) {
+        return false;
+    }
+
+    ggml_tensor * get = cgraph->nodes[i];
+    if (get == nullptr || get->op != GGML_OP_GET_ROWS || get->src[0] == nullptr ||
+            get->src[1] == nullptr || get->type != GGML_TYPE_F32 ||
+            get->src[0]->type != GGML_TYPE_F32 || get->src[1]->type != GGML_TYPE_I32 ||
+            !ggml_is_contiguous(get) || !ggml_is_contiguous(get->src[0]) ||
+            ggml_nrows(get->src[0]) != 1 || ggml_nrows(get) != 1 ||
+            ggml_nelements(get) != 128LL * 128 * 24) {
+        return false;
+    }
+
+    int gdn_index = -1;
+    for (int j = i + 1; j < cgraph->n_nodes && j <= i + 32; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node != nullptr && node->op == GGML_OP_GATED_DELTA_NET &&
+                node->src[5] != nullptr && ggml_sycl_unwrap_shape_view(node->src[5]) == get) {
+            if (gdn_index >= 0) {
+                return false;
+            }
+            gdn_index = j;
+        }
+    }
+    if (gdn_index < 0) {
+        return false;
+    }
+
+    ggml_tensor * gdn = cgraph->nodes[gdn_index];
+    ggml_tensor * beta = gdn->src[4];
+    ggml_tensor * value = gdn->src[2];
+    if (beta == nullptr || value == nullptr || beta->op != GGML_OP_UNARY ||
+            ggml_get_unary_op(beta) != GGML_UNARY_OP_SIGMOID || beta->src[0] == nullptr ||
+            std::strstr(beta->name, "beta_sigmoid-") == nullptr ||
+            gdn->type != GGML_TYPE_F32 || value->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(gdn) || !ggml_is_contiguous(gdn->src[5]) ||
+            value->ne[0] != 128 || value->ne[1] != 24 ||
+            value->ne[2] != 1 || value->ne[3] != 1 ||
+            ggml_get_op_params_i32(gdn, 0) != 1) {
+        return false;
+    }
+
+    const int64_t attn_elems = ggml_nelements(value);
+    const int64_t state_elems = ggml_nelements(get);
+    if (ggml_nelements(gdn) != attn_elems + state_elems) {
+        return false;
+    }
+
+    ggml_tensor * state_view = nullptr;
+    int state_view_index = -1;
+    for (int j = gdn_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node != nullptr && node->op == GGML_OP_VIEW && node->src[0] == gdn &&
+                std::strstr(node->name, "new_state-") != nullptr) {
+            if (state_view != nullptr) {
+                return false;
+            }
+            state_view = node;
+            state_view_index = j;
+        }
+    }
+    if (state_view == nullptr || state_view->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(state_view) || ggml_nelements(state_view) != state_elems ||
+            state_view->data != static_cast<char *>(gdn->data) + attn_elems * sizeof(float)) {
+        return false;
+    }
+
+    ggml_tensor * cpy = nullptr;
+    for (int j = state_view_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (node->src[s] != state_view) {
+                continue;
+            }
+            if (node->op != GGML_OP_CPY || s != 0 || cpy != nullptr ||
+                    std::strstr(node->name, "copy of new_state-") == nullptr) {
+                return false;
+            }
+            cpy = node;
+        }
+    }
+    if (cpy == nullptr || cpy->src[1] == nullptr) {
+        return false;
+    }
+
+    ggml_tensor * state = cpy->src[1];
+    if (state->type != GGML_TYPE_F32 || !ggml_is_contiguous(state) ||
+            ggml_nelements(state) != state_elems ||
+            state->data != get->src[0]->data || state->data == get->data ||
+            ggml_sycl_pair_ranges_overlap(state, gdn)) {
+        return false;
+    }
+
+    // The GET_ROWS result may flow through shape-only aliases, but its only
+    // compute consumer must be this GDN state input.  Likewise, the elided
+    // state view must feed only the matched CPY.
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (node == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = node->src[s];
+            if (src != nullptr && ggml_sycl_unwrap_shape_view(src) == get) {
+                const bool shape_only = node->op == GGML_OP_RESHAPE || node->op == GGML_OP_VIEW ||
+                    node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE;
+                if (!shape_only && !(node == gdn && s == 5)) {
+                    return false;
+                }
+            }
+            if (src == state_view && node != cpy) {
+                return false;
+            }
+        }
+    }
+
+    match->gdn = gdn;
+    match->cpy = cpy;
+    match->state = state;
+    return true;
+}
+
+struct ggml_sycl_qrope_fattn_match {
+    ggml_tensor * rope;
+    ggml_tensor * fattn;
+};
+
+struct ggml_sycl_qk_rope_match {
+    ggml_tensor * q_rope;
+    ggml_tensor * k_rope;
+    ggml_tensor * k_set_rows;
+    int k_nodes_consumed;
+};
+
+struct ggml_sycl_qk_norm_rope_match {
+    ggml_tensor * q_rms;
+    ggml_tensor * q_mul;
+    ggml_tensor * q_rope;
+    ggml_tensor * k_rms;
+    ggml_tensor * k_mul;
+    ggml_tensor * k_rope;
+    ggml_tensor * k_set_rows;
+    int k_nodes_consumed;
+};
+
+// Validate the exact one-token Qwen3.6 Q alias chain. The joined Q/K launch
+// defers Q materialization only until K-RoPE; attention itself is unchanged.
+static bool ggml_sycl_find_qrope_fattn(
+        const ggml_cgraph * cgraph, int i, ggml_sycl_qrope_fattn_match * match) {
+    if (cgraph == nullptr || match == nullptr || i < 0 || i >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * rope = cgraph->nodes[i];
+    if (rope == nullptr || rope->op != GGML_OP_ROPE || rope->src[0] == nullptr ||
+            rope->src[1] == nullptr || rope->src[2] != nullptr ||
+            rope->type != GGML_TYPE_F32 || rope->src[0]->type != GGML_TYPE_F32 ||
+            rope->src[1]->type != GGML_TYPE_I32 ||
+            rope->ne[0] != 256 || rope->ne[1] != 12 || rope->ne[2] != 1 || rope->ne[3] != 1 ||
+            rope->src[1]->ne[0] != 4 || ggml_nelements(rope->src[1]) != 4 ||
+            rope->data != rope->src[0]->data || std::strstr(rope->name, "Qcur-") == nullptr ||
+            (rope->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    const int32_t * ip = (const int32_t *) rope->op_params;
+    float fp[6];
+    memcpy(fp, ip + 5, sizeof(fp));
+    if (ip[1] != 64 || ip[2] != GGML_ROPE_TYPE_IMROPE || ip[4] != 262144 ||
+            fp[0] != 10000000.0f || fp[1] != 1.0f || fp[2] != 0.0f || fp[3] != 1.0f ||
+            fp[4] != 32.0f || fp[5] != 1.0f ||
+            ip[11] != 11 || ip[12] != 11 || ip[13] != 10 || ip[14] != 0) {
+        return false;
+    }
+
+    ggml_tensor * fattn = nullptr;
+    ggml_tensor * q = nullptr;
+    ggml_tensor * view = nullptr;
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_FLASH_ATTN_EXT ||
+                candidate->src[0] == nullptr || candidate->src[0]->op != GGML_OP_PERMUTE ||
+                candidate->src[0]->src[0] == nullptr || candidate->src[0]->src[0]->op != GGML_OP_VIEW ||
+                candidate->src[0]->src[0]->src[0] != rope) {
+            continue;
+        }
+        if (fattn != nullptr) {
+            return false;
+        }
+        fattn = candidate;
+        q = candidate->src[0];
+        view = q->src[0];
+    }
+    if (fattn == nullptr || q == nullptr || view == nullptr ||
+            fattn->src[1] == nullptr || fattn->src[2] == nullptr || fattn->src[3] == nullptr ||
+            fattn->src[4] != nullptr || q->type != GGML_TYPE_F32 || view->type != GGML_TYPE_F32 ||
+            q->ne[0] != 256 || q->ne[1] != 1 || q->ne[2] != 12 || q->ne[3] != 1 ||
+            q->nb[0] != 4 || q->nb[1] != 12288 || q->nb[2] != 1024 || q->nb[3] != 12288 ||
+            view->ne[0] != 256 || view->ne[1] != 12 || view->ne[2] != 1 || view->ne[3] != 1 ||
+            view->nb[0] != 4 || view->nb[1] != 1024 || view->nb[2] != 12288 || view->nb[3] != 12288 ||
+            q->data != rope->data || view->data != rope->data ||
+            fattn->src[1]->ne[0] != 256 || fattn->src[1]->ne[2] != 2 ||
+            fattn->src[2]->ne[0] != 256 || fattn->src[2]->ne[2] != 2 ||
+            fattn->src[3]->type != GGML_TYPE_F16 || fattn->src[3]->ne[3] <= 0 ||
+            (q->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+            (view->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    int rope_uses = 0;
+    int view_uses = 0;
+    int q_uses = 0;
+    for (int j = 0; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * consumer = cgraph->nodes[j];
+        if (consumer == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (consumer->src[s] == rope) {
+                ++rope_uses;
+                if (consumer != view || s != 0) {
+                    return false;
+                }
+            }
+            if (consumer->src[s] == view) {
+                ++view_uses;
+                if (consumer != q || s != 0) {
+                    return false;
+                }
+            }
+            if (consumer->src[s] == q) {
+                ++q_uses;
+                if (consumer != fattn || s != 0) {
+                    return false;
+                }
+            }
+        }
+    }
+    if (rope_uses != 1 || view_uses != 1 || q_uses != 1) {
+        return false;
+    }
+
+    match->rope = rope;
+    match->fattn = fattn;
+    return true;
+}
+
+// Join the one-token Q and K IMRoPE workgroups into one launch while retaining
+// the direct K-to-F16-cache path. Every shape, scalar, consumer edge and cache
+// memory range is checked before Q may be deferred.
+static bool ggml_sycl_find_qk_rope(
+        const ggml_cgraph * cgraph, int i, ggml_sycl_qk_rope_match * match) {
+    ggml_sycl_qrope_fattn_match q_match{};
+    if (!ggml_sycl_find_qrope_fattn(cgraph, i, &q_match)) {
+        return false;
+    }
+
+    ggml_sycl_qk_rope_match found{};
+    int matches = 0;
+    for (int j = i + 1; j < cgraph->n_nodes && cgraph->nodes[j] != q_match.fattn; ++j) {
+        ggml_tensor * rope = cgraph->nodes[j];
+        if (rope == nullptr || rope->op != GGML_OP_ROPE || rope->src[0] == nullptr ||
+                rope->src[1] != q_match.rope->src[1] || rope->src[2] != nullptr ||
+                rope->type != GGML_TYPE_F32 || rope->src[0]->type != GGML_TYPE_F32 ||
+                rope->ne[0] != 256 || rope->ne[1] != 2 || rope->ne[2] != 1 || rope->ne[3] != 1 ||
+                std::strstr(rope->name, "Kcur-") == nullptr ||
+                std::memcmp(rope->op_params, q_match.rope->op_params, GGML_MAX_OP_PARAMS) != 0) {
+            continue;
+        }
+
+        ggml_tensor * view = nullptr;
+        ggml_tensor * set_rows = nullptr;
+        int nodes_consumed = 0;
+        if (j + 2 < cgraph->n_nodes && cgraph->nodes[j + 1]->op == GGML_OP_VIEW &&
+                cgraph->nodes[j + 2]->op == GGML_OP_SET_ROWS) {
+            view = cgraph->nodes[j + 1];
+            set_rows = cgraph->nodes[j + 2];
+            nodes_consumed = 2;
+        } else if (j + 1 < cgraph->n_nodes && cgraph->nodes[j + 1]->op == GGML_OP_SET_ROWS &&
+                cgraph->nodes[j + 1]->src[0] != nullptr &&
+                cgraph->nodes[j + 1]->src[0]->op == GGML_OP_VIEW) {
+            view = cgraph->nodes[j + 1]->src[0];
+            set_rows = cgraph->nodes[j + 1];
+            nodes_consumed = 1;
+        }
+        if (view == nullptr || set_rows == nullptr) {
+            continue;
+        }
+
+        const int out_node = j + nodes_consumed;
+        const bool closure_ok =
+            ggml_node_get_use_count(cgraph, j) == 1 &&
+            (rope->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 &&
+            view->src[0] == rope && set_rows->src[0] == view &&
+            (nodes_consumed == 1 ||
+             (ggml_node_get_use_count(cgraph, j + 1) == 1 &&
+              (view->flags & GGML_TENSOR_FLAG_OUTPUT) == 0));
+        const bool valid =
+            closure_ok && rope->src[0]->ne[3] == 1 &&
+            set_rows->type == GGML_TYPE_F16 &&
+            set_rows->src[1] != nullptr && set_rows->src[1]->type == GGML_TYPE_I64 &&
+            ggml_is_contiguous(view) && view->ne[0] == rope->ne[0] * rope->ne[1] &&
+            ggml_sycl_check_fusion_memory_ranges(
+                cgraph, j, nodes_consumed + 1, &out_node, 1, false, false);
+        if (!valid) {
+            continue;
+        }
+
+        found.q_rope = q_match.rope;
+        found.k_rope = rope;
+        found.k_set_rows = set_rows;
+        found.k_nodes_consumed = nodes_consumed;
+        ++matches;
+    }
+
+    if (matches != 1) {
+        return false;
+    }
+    *match = found;
+    return true;
+}
+
+// Join both exact Qwen3.6 attention normalization chains with IMRoPE.  The
+// matcher starts at Q RMS_NORM, requires the incumbent adjacent RMS+MUL
+// fusion contract on Q and K, and retains the stronger Q/K RoPE closure and
+// cache-range checks above.
+static bool ggml_sycl_find_qk_norm_rope(
+        const ggml_cgraph * cgraph, int i, ggml_sycl_qk_norm_rope_match * match) {
+    if (cgraph == nullptr || match == nullptr || i < 0 || i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * q_rms = cgraph->nodes[i];
+    ggml_tensor * q_mul = cgraph->nodes[i + 1];
+    ggml_tensor * q_rope = cgraph->nodes[i + 2];
+    if (q_rms == nullptr || q_mul == nullptr || q_rope == nullptr ||
+            q_rms->op != GGML_OP_RMS_NORM || q_mul->op != GGML_OP_MUL ||
+            q_rope->op != GGML_OP_ROPE || q_rope->src[0] != q_mul ||
+            !ggml_sycl_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }) ||
+            ggml_node_get_use_count(cgraph, i) != 1 ||
+            ggml_node_get_use_count(cgraph, i + 1) != 1 ||
+            (q_rms->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+            (q_mul->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    ggml_sycl_qk_rope_match rope_match{};
+    if (!ggml_sycl_find_qk_rope(cgraph, i + 2, &rope_match) || rope_match.q_rope != q_rope) {
+        return false;
+    }
+
+    ggml_tensor * k_mul = rope_match.k_rope->src[0];
+    if (k_mul == nullptr || k_mul->op != GGML_OP_MUL) {
+        return false;
+    }
+    ggml_tensor * k_rms = nullptr;
+    if (k_mul->src[0] != nullptr && k_mul->src[0]->op == GGML_OP_RMS_NORM) {
+        k_rms = k_mul->src[0];
+    }
+    if (k_mul->src[1] != nullptr && k_mul->src[1]->op == GGML_OP_RMS_NORM) {
+        if (k_rms != nullptr) {
+            return false;
+        }
+        k_rms = k_mul->src[1];
+    }
+    if (k_rms == nullptr) {
+        return false;
+    }
+
+    int k_i = -1;
+    for (int j = i + 3; j < cgraph->n_nodes; ++j) {
+        if (cgraph->nodes[j] == k_rms) {
+            k_i = j;
+            break;
+        }
+    }
+    if (k_i < 0 || k_i + 2 >= cgraph->n_nodes ||
+            cgraph->nodes[k_i + 1] != k_mul || cgraph->nodes[k_i + 2] != rope_match.k_rope ||
+            !ggml_sycl_can_fuse(cgraph, k_i, { GGML_OP_RMS_NORM, GGML_OP_MUL }) ||
+            ggml_node_get_use_count(cgraph, k_i) != 1 ||
+            ggml_node_get_use_count(cgraph, k_i + 1) != 1 ||
+            (k_rms->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+            (k_mul->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    const ggml_tensor * q_src = q_rms->src[0];
+    const ggml_tensor * k_src = k_rms->src[0];
+    const ggml_tensor * q_weight = q_mul->src[0] == q_rms ? q_mul->src[1] : q_mul->src[0];
+    const ggml_tensor * k_weight = k_mul->src[0] == k_rms ? k_mul->src[1] : k_mul->src[0];
+    if (q_src == nullptr || k_src == nullptr || q_weight == nullptr || k_weight == nullptr ||
+            q_src->type != GGML_TYPE_F32 || k_src->type != GGML_TYPE_F32 ||
+            q_weight->type != GGML_TYPE_F32 || k_weight->type != GGML_TYPE_F32 ||
+            q_src->ne[0] != 256 || q_src->ne[1] != 12 || q_src->ne[2] != 1 || q_src->ne[3] != 1 ||
+            k_src->ne[0] != 256 || k_src->ne[1] != 2 || k_src->ne[2] != 1 || k_src->ne[3] != 1 ||
+            q_weight->ne[0] != 256 || ggml_nelements(q_weight) != 256 ||
+            k_weight->ne[0] != 256 || ggml_nelements(k_weight) != 256 ||
+            q_src->nb[0] != sizeof(float) || k_src->nb[0] != sizeof(float) ||
+            q_weight->nb[0] != sizeof(float) || k_weight->nb[0] != sizeof(float)) {
+        return false;
+    }
+
+    float q_eps = 0.0f;
+    float k_eps = 0.0f;
+    memcpy(&q_eps, q_rms->op_params, sizeof(float));
+    memcpy(&k_eps, k_rms->op_params, sizeof(float));
+    if (q_eps < 0.0f || q_eps != k_eps) {
+        return false;
+    }
+
+    match->q_rms = q_rms;
+    match->q_mul = q_mul;
+    match->q_rope = q_rope;
+    match->k_rms = k_rms;
+    match->k_mul = k_mul;
+    match->k_rope = rope_match.k_rope;
+    match->k_set_rows = rope_match.k_set_rows;
+    match->k_nodes_consumed = rope_match.k_nodes_consumed;
+    return true;
+}
