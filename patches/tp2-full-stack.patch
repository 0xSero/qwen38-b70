+                    tmp += sums[wi_in_sg + j * WARP_SIZE];
+                }
+                tmp = warp_reduce_sum(tmp, item);
+            }
+            const float scale = sycl::rsqrt(tmp / nelem + eps0);
+            const auto sg = item.get_sub_group();
+            const int sg_id = (int) sg.get_group_linear_id();
+            const int lane = (int) sg.get_local_linear_id();
+            int8_t * qs = reinterpret_cast<int8_t *>(q8_out0);
+            sycl::half2 * ds = reinterpret_cast<sycl::half2 *>(q8_out0 + nelem);
