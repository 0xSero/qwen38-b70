+// Lab adaptation of upstream 650913862 for the per-device graph slices emitted
+// by the TP2 meta backend. The public upstream path declines split buffers at
+// the unsliced graph level; here each SYCL backend sees its local gate/up rows,
+// so the same fused row kernel can safely produce the local SWIGLU output.
+static bool ggml_sycl_fuse_q4k_mmvq_swiglu(
+        ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!g_ggml_sycl_fused_mmvq_swiglu_q4k || i < 0 || i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * first = cgraph->nodes[i];
+    ggml_tensor * second = cgraph->nodes[i + 1];
+    ggml_tensor * glu = cgraph->nodes[i + 2];
+    if (first == nullptr || second == nullptr || glu == nullptr ||
+            first->op != GGML_OP_MUL_MAT || second->op != GGML_OP_MUL_MAT ||
+            glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU ||
+            ggml_get_op_params_i32(glu, 1) != 0) {
+        return false;
+    }
+
+    ggml_tensor * gate = glu->src[0];
+    ggml_tensor * up = glu->src[1];
+    if (!((gate == first && up == second) || (gate == second && up == first)) ||
+            gate->src[0] == nullptr || gate->src[1] == nullptr ||
+            up->src[0] == nullptr || up->src[1] != gate->src[1]) {
+        return false;
+    }
+
+    const int idxs[3] = { i, i + 1, i + 2 };
+    const enum ggml_op ops[3] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU };
+    const int outputs[1] = { i + 2 };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 3, ops, outputs, 1)) {
+        return false;
+    }
+
+    ggml_tensor * wg = gate->src[0];
+    ggml_tensor * wu = up->src[0];
+    ggml_tensor * act = up->src[1];
+    if (wg->type != GGML_TYPE_Q4_K || wu->type != GGML_TYPE_Q4_K ||
+            act->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32 ||
+            !ggml_are_same_shape(wg, wu) || !ggml_are_same_stride(wg, wu) ||
+            !ggml_is_contiguous(wg) || !ggml_is_contiguous(wu) ||
+            !ggml_is_contiguous(act) || !ggml_is_contiguous(glu) ||
+            ggml_backend_buffer_is_sycl_split(wg->buffer) ||
+            ggml_backend_buffer_is_sycl_split(wu->buffer) ||
+            ggml_nrows(act) != 1 || gate->ne[1] != 1 || up->ne[1] != 1 ||
+            act->ne[2] != 1 || act->ne[3] != 1 ||
+            wg->ne[0] != act->ne[0] || wu->ne[0] != act->ne[0] ||
+            gate->ne[0] != wg->ne[1] || up->ne[0] != wu->ne[1] ||
+            glu->ne[0] != wu->ne[1] || glu->ne[1] != 1 ||
+            act->ne[0] % QK8_1 != 0) {
+        return false;
+    }
+
+    opt_for_reorder(&ctx, wu, act, up, mul_mat_algo::MMVQ);
+    opt_for_reorder(&ctx, wg, act, gate, mul_mat_algo::MMVQ);
+    const auto * eu = static_cast<const ggml_tensor_extra_gpu *>(wu->extra);
+    const auto * eg = static_cast<const ggml_tensor_extra_gpu *>(wg->extra);
+    if (eu == nullptr || eg == nullptr ||
+            !eu->optimized_feature.reorder || !eg->optimized_feature.reorder) {
+        return false;
+    }
+
+    const int64_t padded = GGML_PAD(act->ne[0], MATRIX_ROW_PADDING);
+    const size_t q8_size = (size_t) padded * sizeof(block_q8_1) / QK8_1;
+    bool hit = false;
+    char * q8 = ggml_sycl_q8_dedup_lookup(
+        ctx, act, /* reordered SOA = */ 1, act->ne[0], 1, padded, q8_size, hit);
+    if (q8 == nullptr) {
+        return false;
+    }
+    if (!hit) {
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            static_cast<const float *>(act->data), q8, act->ne[0], 1, padded, ctx.stream());
+        g_q8_quant_launches.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    if (!ggml_sycl_mul_mat_vec_q4_k_reorder_swiglu(
+            wu->data, wg->data, q8, static_cast<float *>(glu->data),
+            (int) act->ne[0], (int) wu->ne[1], ctx.stream())) {
+        return false;
+    }
+
+    // Relative to the two stock mat-vec consumers, one duplicate activation
+    // quantization is eliminated even when this lookup itself was a miss.
+    g_q8_dedup_hits.fetch_add(hit ? 2 : 1, std::memory_order_relaxed);
+    g_q4k_fused_mmvq_swiglus.fetch_add(1, std::memory_order_relaxed);
+    const char * poison = std::getenv("GGML_SYCL_FUSED_MMVQ_SWIGLU_Q4K_POISON");
+    if (poison != nullptr && std::atoi(poison) != 0) {
+        ctx.stream()->memset(glu->data, 0x7f, sizeof(float));
+    }
+    return true;
+}
